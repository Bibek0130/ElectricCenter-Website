# Copy this file to .env and fill in real values. .env is git-ignored.

# Google Maps JavaScript API key, used by the store-locator map on the home page.
VITE_GOOGLE_MAPS_API_KEY=

# Base URL the SPA calls for backend API requests. Leave as /api in development —
# vite.config.js proxies it to the ASP.NET Core server automatically.
VITE_API_BASE_URL=/api

# WhatsApp booking-notification strategy: "click-to-chat" (default, no backend
# needed) or "cloud-api" (calls the server, which needs WHATSAPP_TOKEN /
# WHATSAPP_PHONE_NUMBER_ID set as real environment variables — see the
# server-side .env.example / README for details). Falls back to click-to-chat
# automatically if the Cloud API call fails.
VITE_WHATSAPP_STRATEGY=click-to-chat
